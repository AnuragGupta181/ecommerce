NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# Neon: pooled URL for the app, direct URL for migrations
# Optional: ipv4first if IPv6 connections to the database hang on your network (ipv6first for the reverse)
# DB_DNS_ORDER=ipv4first
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# Integration tests: isolated schema (never point at production data)
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=verify-full&schema=haat_test"

JWT_ACCESS_SECRET=change-me-64-random-chars
JWT_REFRESH_SECRET=change-me-another-64-random-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Email (Mailpit in dev: docker compose up -d mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Haat <no-reply@haat.local>"

# WhatsApp: meta | twilio | log
WHATSAPP_PROVIDER=log
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

ADMIN_SEED_EMAIL=admin@haat.local
ADMIN_SEED_PASSWORD=change-me

# Marketplace
# Distance: haversine x ROAD_FACTOR; set ORS_API_KEY (openrouteservice.org free tier) for road distance
ROAD_FACTOR=1.3
ORS_API_KEY=
# Vercel Cron / Render Cron / EventBridge call GET /api/v1/cron/daily with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=change-me
# Admin/vendor portal URL, used in emails and rider schedule links
PORTAL_URL=http://localhost:3000
# Uploads: local (dev) | cloudinary | vercel-blob (Vercel) | s3 (Render / AWS / R2)
STORAGE_DRIVER=local
# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
BLOB_READ_WRITE_TOKEN=
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# Long-running servers only (Render / AWS): run the daily job in-process at 18:00 IST
ENABLE_SCHEDULER=false
