// Haat data model. All money columns are integer paise.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Identity ─────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
  VENDOR
}

enum VendorMemberRole {
  OWNER
  STAFF
}

model User {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  phone        String?           @unique
  passwordHash String
  role         Role              @default(CUSTOMER)
  isBlocked    Boolean           @default(false)
  avatarUrl    String?
  coinBalance  Int               @default(0)
  referralCode String?           @unique
  /// Set for VENDOR users: the shop they work for.
  vendorId     String?
  vendorRole   VendorMemberRole?
  /// The one ADMIN who can manage other admin accounts.
  isSuperAdmin Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  refreshTokens     RefreshToken[]
  passwordResets    PasswordReset[]
  addresses         Address[]
  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  orders            Order[]
  coinTransactions  CoinTransaction[]
  couponRedemptions CouponRedemption[]
  reviews           Review[]
  notifications     Notification[]
  referralsGiven    Referral[]         @relation("ReferrerReferrals")
  referralReceived  Referral?          @relation("RefereeReferral")
  vendor            Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  subscriptions     Subscription[]
  tickets           Ticket[]
  conversations     Conversation[]
  auditLogs         AuditLog[]

  @@index([role, createdAt])
  @@index([vendorId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  /// Set only when the token was rotated (not on logout/block), so a racing refresh can be told apart from theft.
  rotatedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  otpHash   String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum AddressType {
  HOME
  WORK
  OTHER
}

model Address {
  id        String      @id @default(cuid())
  userId    String
  name      String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  /// Delivery point; drives distance and delivery fee.
  lat       Float?
  lng       Float?
  type      AddressType @default(HOME)
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────────── Catalog ─────────────────────────────

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  imageUrl  String?
  parentId  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId, sortOrder])
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  description       String   @default("")
  highlights        String[]
  /// Array of { label: string, value: string }
  specs             Json     @default("[]")
  tags              String[]
  categoryId        String
  brandId           String?
  isActive          Boolean  @default(true)
  isFeatured        Boolean  @default(false)
  /// Vendor that added this catalog product (null = added by the platform).
  createdByVendorId String?

  // Denormalised for listing filters/sorting; kept in sync by the products service.
  minPrice        Int   @default(0)
  minMrp          Int   @default(0)
  discountPercent Int   @default(0)
  ratingAvg       Float @default(0)
  ratingCount     Int   @default(0)
  soldCount       Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand           Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images          ProductImage[]
  variants        ProductVariant[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
  orderItems      OrderItem[]
  createdByVendor Vendor?          @relation(fields: [createdByVendorId], references: [id], onDelete: SetNull)

  @@index([categoryId, isActive])
  @@index([brandId])
  @@index([isActive, isFeatured])
  @@index([isActive, soldCount])
  @@index([isActive, minPrice])
  @@index([isActive, createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  sku               String   @unique
  label             String   @default("Default")
  /// e.g. { "size": "M", "color": "Red" }
  attributes        Json     @default("{}")
  mrp               Int
  price             Int
  stock             Int      @default(0)
  lowStockThreshold Int      @default(5)
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  branchStock    BranchVariantStock[]

  @@index([productId])
  @@index([stock])
}

enum StockMovementType {
  IN
  OUT
  SET
  SALE
  CANCEL
  RETURN
  SUBSCRIPTION
  COUNTER_SALE
}

model StockMovement {
  id          String            @id @default(cuid())
  variantId   String
  type        StockMovementType
  /// Signed delta applied to stock.
  quantity    Int
  stockAfter  Int
  reason      String?
  orderId     String?
  createdById String?
  createdAt   DateTime          @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
  @@index([orderId])
}

model SearchTerm {
  term      String   @id
  count     Int      @default(1)
  updatedAt DateTime @updatedAt

  @@index([count])
}

// ───────────────────────────── Shopping ─────────────────────────────

model WishlistItem {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  variantId String
  /// The shop this cart buys from; every line in a user's cart shares it.
  branchId  String?
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  branch  Branch?        @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
}

// ───────────────────────────── Promotions ─────────────────────────────

enum CouponType {
  PERCENT
  FLAT
}

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  description    String     @default("")
  type           CouponType
  /// Percent (1-100) for PERCENT, paise for FLAT.
  value          Int
  maxDiscount    Int?
  minOrderValue  Int        @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  usageLimit     Int?
  perUserLimit   Int        @default(1)
  usedCount      Int        @default(0)
  firstOrderOnly Boolean    @default(false)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  redemptions CouponRedemption[]
  orders      Order[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String   @unique
  discount  Int
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
}

enum CoinTransactionType {
  EARN
  REDEEM
  REFUND
  REVERSE
  ADJUST
  BONUS
}

model CoinTransaction {
  id           String              @id @default(cuid())
  userId       String
  type         CoinTransactionType
  /// Signed: positive credits, negative debits. 1 coin = ₹1.
  amount       Int
  balanceAfter Int
  orderId      String?
  note         String?
  createdAt    DateTime            @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model Banner {
  id        String          @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  linkType  BannerLinkType  @default(NONE)
  linkValue String?
  placement BannerPlacement @default(HOME_CAROUSEL)
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([placement, isActive, sortOrder])
}

enum BannerLinkType {
  NONE
  PRODUCT
  CATEGORY
  SEARCH
  URL
}

enum BannerPlacement {
  HOME_CAROUSEL
  HOME_STRIP
}

// ───────────────────────────── Orders & delivery ─────────────────────────────

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  RIDER_ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  RETURN_REJECTED
}

enum PaymentMethod {
  COD
  UPI_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  userId        String
  /// Branch that fulfils this order (resolved at checkout; null for legacy orders).
  branchId      String?
  vendorId      String?
  status        OrderStatus   @default(PLACED)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)

  /// Snapshot of the delivery address at order time.
  shippingAddress Json

  itemsMrp         Int
  itemsTotal       Int
  couponId         String?
  couponCode       String?
  couponDiscount   Int     @default(0)
  coinsUsed        Int     @default(0)
  deliveryFee      Int     @default(0)
  payable          Int
  coinsToEarn      Int     @default(0)
  coinsEarned      Int     @default(0)
  /// Straight-line or road distance used for the delivery fee.
  distanceKm       Float?
  /// Commission snapshot (basis points of itemsTotal) and what the vendor is owed.
  commissionBps    Int     @default(0)
  commissionAmount Int     @default(0)
  vendorEarning    Int     @default(0)
  payoutId         String?
  invoiceNumber    String? @unique

  riderId         String?
  riderAssignedAt DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  returnReason    String?
  customerNote    String?
  adminNote       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon           Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  rider            Rider?               @relation(fields: [riderId], references: [id], onDelete: SetNull)
  branch           Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  vendor           Vendor?              @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  payout           Payout?              @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  tickets          Ticket[]
  history          OrderStatusHistory[]
  couponRedemption CouponRedemption?
  coinTransactions CoinTransaction[]
  notificationLogs NotificationLog[]
  referral         Referral?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([riderId])
  @@index([branchId])
  @@index([vendorId, status, createdAt])
  @@index([payoutId])
  @@index([createdAt])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  variantId    String
  productName  String
  variantLabel String
  sku          String
  imageUrl     String?
  mrp          Int
  price        Int
  /// Vendor cost at order time, for profit reports (null when the vendor never set one).
  costPrice    Int?
  quantity     Int
  lineTotal    Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  actorId   String?
  actorRole String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

enum VehicleType {
  BIKE
  SCOOTER
  BICYCLE
  CAR
  VAN
  OTHER
}

model Rider {
  id            String      @id @default(cuid())
  name          String
  phone         String      @unique
  whatsapp      String?
  email         String?
  vehicleType   VehicleType @default(BIKE)
  vehicleNumber String?
  idProofType   String?
  idProofNumber String?
  address       String?
  notes         String?
  isActive      Boolean     @default(true)
  vendorId      String?
  /// Secret for the rider's no-login schedule page (shared over WhatsApp/email).
  linkToken     String?     @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  orders        Order[]
  subscriptions Subscription[]
  branches      BranchRider[]
  vendor        Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([vendorId])
}

// ───────────────────────────── Engagement ─────────────────────────────

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  orderId   String?
  rating    Int
  title     String?
  comment   String?
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId, isHidden, createdAt])
}

enum NotificationType {
  ORDER
  PROMO
  SYSTEM
  SUBSCRIPTION
  SUPPORT
  CHAT
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum RecipientType {
  CUSTOMER
  RIDER
  ADMIN
  VENDOR
}

enum DeliveryStatus {
  SENT
  FAILED
  SKIPPED
}

model NotificationLog {
  id            String              @id @default(cuid())
  channel       NotificationChannel
  recipientType RecipientType
  recipient     String
  template      String
  subject       String?
  body          String
  status        DeliveryStatus
  error         String?
  providerRef   String?
  orderId       String?
  createdAt     DateTime            @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([createdAt])
}

enum ReferralStatus {
  PENDING
  COMPLETED
  REVERSED
}

model Referral {
  id            String         @id @default(cuid())
  referrerId    String
  refereeId     String         @unique
  status        ReferralStatus @default(PENDING)
  orderId       String?        @unique
  referrerCoins Int            @default(50)
  refereeCoins  Int            @default(25)
  completedAt   DateTime?
  reversedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  referrer User   @relation("ReferrerReferrals", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User   @relation("RefereeReferral", fields: [refereeId], references: [id], onDelete: Cascade)
  order    Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([referrerId, status])
  @@index([refereeId])
  @@index([orderId])
}

model Settings {
  id                    Int      @id @default(1)
  storeName             String   @default("Haat")
  supportEmail          String   @default("support@haat.local")
  supportPhone          String   @default("")
  adminEmail            String   @default("")
  adminWhatsapp         String   @default("")
  deliveryFee           Int      @default(4000)
  freeDeliveryThreshold Int      @default(49900)
  coinEarnPer100        Int      @default(2)
  coinMaxRedeemPercent  Int      @default(20)
  returnWindowDays      Int      @default(7)
  codEnabled            Boolean  @default(true)
  upiOnDeliveryEnabled  Boolean  @default(true)
  referralEnabled       Boolean  @default(true)
  referralReferrerCoins Int      @default(50)
  referralRefereeCoins  Int      @default(25)
  updatedAt             DateTime @updatedAt
}

// ───────────────────────────── Branches ─────────────────────────────

model Branch {
  id                String   @id @default(cuid())
  vendorId          String
  name              String
  slug              String   @unique
  address           String
  city              String
  state             String
  pincode           String
  /// Decimal degrees (WGS-84)
  lat               Float
  /// Decimal degrees (WGS-84)
  lng               Float
  /// Furthest delivery, in km.
  deliveryRadiusKm  Float    @default(5)
  /// Delivery fee = max(minDeliveryFee, distanceKm × deliveryRatePerKm); paise.
  deliveryRatePerKm Int      @default(1000)
  minDeliveryFee    Int      @default(2000)
  /// Free delivery at or above this items total (null = never free).
  freeDeliveryAbove Int?
  /// Opening hours in shop-local time, "HH:MM"; null = open all day.
  opensAt           String?
  closesAt          String?
  phone             String?
  email             String?
  isActive          Boolean  @default(true)
  /// Operational on/off switch controlled by the admin.
  isOnline          Boolean  @default(true)
  /// Shown to the customer when isOnline = false, e.g. "Back at 9 AM".
  offlineMessage    String?
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vendor        Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  branchStock   BranchVariantStock[]
  orders        Order[]
  riders        BranchRider[]
  statusLogs    BranchStatusLog[]
  cartItems     CartItem[]
  plans         SubscriptionPlan[]
  subscriptions Subscription[]

  @@index([vendorId])
  @@index([isActive, isOnline])
  @@index([lat, lng])
}

model BranchVariantStock {
  id                String   @id @default(cuid())
  branchId          String
  variantId         String
  /// The vendor's own selling price and MRP for this variant (paise).
  price             Int
  mrp               Int
  /// What the vendor paid; private, used only for profit reports.
  costPrice         Int?
  stock             Int      @default(0)
  lowStockThreshold Int      @default(5)
  /// Admin can hide a variant from this branch's catalog without removing stock.
  isAvailable       Boolean  @default(true)
  updatedAt         DateTime @updatedAt

  branch         Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  variant        ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  stockMovements BranchStockMovement[]
  plans          SubscriptionPlan[]

  @@unique([branchId, variantId])
  @@index([branchId, stock])
  @@index([variantId])
}

model BranchStockMovement {
  id                     String            @id @default(cuid())
  branchStockId          String
  /// Reuses the global enum: IN | OUT | SET | SALE | CANCEL | RETURN
  type                   StockMovementType
  /// Signed delta; negative removes stock.
  quantity               Int
  stockAfter             Int
  reason                 String?
  orderId                String?
  subscriptionDeliveryId String?
  createdById            String?
  createdAt              DateTime          @default(now())

  branchStock BranchVariantStock @relation(fields: [branchStockId], references: [id], onDelete: Cascade)

  @@index([branchStockId, createdAt])
  @@index([orderId])
}

/// Many-to-many: riders assigned to branches.
model BranchRider {
  branchId String
  riderId  String

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  rider  Rider  @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@id([branchId, riderId])
}

model BranchStatusLog {
  id        String   @id @default(cuid())
  branchId  String
  isOnline  Boolean
  reason    String?
  actorId   String?
  createdAt DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, createdAt])
}

// ───────────────────────────── Vendors ─────────────────────────────

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

/// A shop owner's business on the platform. Customers buy from its branches.
model Vendor {
  id                   String       @id @default(cuid())
  slug                 String       @unique
  shopName             String
  description          String       @default("")
  logoUrl              String?
  phone                String
  email                String
  address              String
  gstin                String?
  idProofType          String?
  idProofNumber        String?
  idProofUrl           String?
  status               VendorStatus @default(PENDING)
  rejectionReason      String?
  /// Platform commission in basis points of itemsTotal (1000 = 10%).
  commissionBps        Int          @default(1000)
  /// Where payouts go: UPI id and/or bank details as free text.
  payoutUpi            String?
  payoutDetails        String?
  /// Turns on the daily-needs / subscription section for this shop.
  subscriptionsEnabled Boolean      @default(false)
  approvedAt           DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  members       User[]
  branches      Branch[]
  orders        Order[]
  riders        Rider[]
  products      Product[]
  plans         SubscriptionPlan[]
  subscriptions Subscription[]
  payouts       Payout[]
  tickets       Ticket[]
  conversations Conversation[]
  counterSales  CounterSale[]

  @@index([status])
}

// ───────────────────────────── Subscriptions ─────────────────────────────

enum SubscriptionPeriod {
  WEEKLY
  MONTHLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

enum SubscriptionDeliveryStatus {
  SCHEDULED
  SKIPPED
  DELIVERED
  MISSED
  CANCELLED
}

enum CollectionMethod {
  CASH
  UPI
  OTHER
}

/// A recurring offer a vendor creates first, e.g. "Milk 1 L daily".
model SubscriptionPlan {
  id                  String   @id @default(cuid())
  vendorId            String
  branchId            String
  listingId           String
  name                String
  description         String   @default("")
  /// Units of the listing per delivery.
  quantityPerDelivery Int      @default(1)
  /// Delivery windows the customer can pick, e.g. "6-8 am".
  slots               String[]
  /// Max active subscribers (null = no limit).
  capacity            Int?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  vendor        Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  branch        Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  listing       BranchVariantStock      @relation(fields: [listingId], references: [id], onDelete: Restrict)
  prices        SubscriptionPlanPrice[]
  subscriptions Subscription[]

  @@index([branchId, isActive])
  @@index([vendorId])
}

enum DeliveryFeeMode {
  /// deliveryFee is charged on every delivery.
  PER_DELIVERY
  /// deliveryFee is one flat charge for the whole period (0 = free delivery).
  PER_PERIOD
}

enum SubscriptionPaymentPlan {
  /// Whole period paid before the first delivery.
  UPFRONT
  /// Half before the start, half at the midpoint.
  TWO_INSTALMENTS
  /// Pay for what was delivered at the end of the period.
  END_OF_PERIOD
}

/// Terms for one period of a plan; monthly is usually cheaper or has free delivery.
model SubscriptionPlanPrice {
  id               String             @id @default(cuid())
  planId           String
  period           SubscriptionPeriod
  pricePerDelivery Int
  deliveryFee      Int                @default(0)
  deliveryFeeMode  DeliveryFeeMode    @default(PER_DELIVERY)

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, period])
}

model Subscription {
  id               String                  @id @default(cuid())
  number           String                  @unique
  userId           String
  planId           String
  vendorId         String
  branchId         String
  /// Snapshot of the delivery address (with lat/lng).
  shippingAddress  Json
  period           SubscriptionPeriod
  startDate        DateTime                @db.Date
  endDate          DateTime                @db.Date
  /// Delivery weekdays as a bitmask: Mon = 1, Tue = 2, ... Sun = 64.
  weekdays         Int
  slot             String?
  quantity         Int
  /// Terms locked when the customer subscribed.
  pricePerDelivery Int
  deliveryFee      Int
  deliveryFeeMode  DeliveryFeeMode
  paymentPlan      SubscriptionPaymentPlan @default(END_OF_PERIOD)
  /// Delivery partner who does the daily drops.
  riderId          String?
  status           SubscriptionStatus      @default(ACTIVE)
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  user        User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan        SubscriptionPlan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  vendor      Vendor                   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  branch      Branch                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  rider       Rider?                   @relation(fields: [riderId], references: [id], onDelete: SetNull)
  deliveries  SubscriptionDelivery[]
  pauses      SubscriptionPause[]
  payments    SubscriptionPayment[]
  instalments SubscriptionInstalment[]
  tickets     Ticket[]

  @@index([userId, createdAt])
  @@index([vendorId, status])
}

/// One scheduled drop. Rows are created up front for the whole period.
model SubscriptionDelivery {
  id             String                     @id @default(cuid())
  subscriptionId String
  date           DateTime                   @db.Date
  status         SubscriptionDeliveryStatus @default(SCHEDULED)
  quantity       Int
  goodsAmount    Int
  deliveryFee    Int
  deliveredAt    DateTime?
  markedById     String?
  note           String?
  payoutId       String?

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payout       Payout?      @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@unique([subscriptionId, date])
  @@index([date, status])
  @@index([payoutId])
}

model SubscriptionPause {
  id             String   @id @default(cuid())
  subscriptionId String
  fromDate       DateTime @db.Date
  toDate         DateTime @db.Date
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

/// What the customer owes and by when, from the payment plan.
model SubscriptionInstalment {
  id             String   @id @default(cuid())
  subscriptionId String
  sequence       Int
  dueDate        DateTime @db.Date
  amount         Int

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, sequence])
}

model SubscriptionPayment {
  id             String           @id @default(cuid())
  receiptNumber  String           @unique
  subscriptionId String
  amount         Int
  method         CollectionMethod @default(CASH)
  note           String?
  recordedById   String?
  paidAt         DateTime         @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, paidAt])
}

// ───────────────────────────── Payouts ─────────────────────────────

enum PayoutStatus {
  PENDING
  PAID
}

/// Settles a vendor's delivered orders and subscription deliveries for a period.
model Payout {
  id               String       @id @default(cuid())
  number           String       @unique
  vendorId         String
  periodFrom       DateTime
  periodTo         DateTime
  orderCount       Int
  deliveryCount    Int
  grossAmount      Int
  commissionAmount Int
  netAmount        Int
  status           PayoutStatus @default(PENDING)
  paidAt           DateTime?
  reference        String?
  note             String?
  createdById      String?
  createdAt        DateTime     @default(now())

  vendor     Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  orders     Order[]
  deliveries SubscriptionDelivery[]

  @@index([vendorId, createdAt])
}

// ───────────────────────────── Support ─────────────────────────────

enum TicketCategory {
  ORDER_ISSUE
  SUBSCRIPTION_ISSUE
  APP_BUG
  PAYMENT
  ACCOUNT
  VENDOR_COMPLAINT
  OTHER
}

/// MINOR tickets go to the vendor (admin sees them too); MAJOR go to the admin only.
enum TicketLevel {
  MINOR
  MAJOR
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum MessageAuthor {
  CUSTOMER
  VENDOR
  ADMIN
  SYSTEM
}

model Ticket {
  id             String         @id @default(cuid())
  number         String         @unique
  userId         String
  category       TicketCategory
  level          TicketLevel
  subject        String
  status         TicketStatus   @default(OPEN)
  orderId        String?
  subscriptionId String?
  /// Set only when the vendor may see the ticket (MINOR).
  vendorId       String?
  lastMessageAt  DateTime       @default(now())
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  order        Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subscription Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  vendor       Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  messages     TicketMessage[]

  @@index([userId, createdAt])
  @@index([vendorId, status])
  @@index([level, status])
}

model TicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  authorId   String?
  authorRole MessageAuthor
  body       String
  createdAt  DateTime      @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// ───────────────────────────── Chat ─────────────────────────────

/// One thread per customer and vendor.
model Conversation {
  id             String   @id @default(cuid())
  userId         String
  vendorId       String
  lastMessageAt  DateTime @default(now())
  lastMessage    String   @default("")
  customerUnread Int      @default(0)
  vendorUnread   Int      @default(0)
  createdAt      DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor   Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([userId, vendorId])
  @@index([vendorId, lastMessageAt])
}

model ChatMessage {
  id             String        @id @default(cuid())
  conversationId String
  senderId       String?
  senderRole     MessageAuthor
  body           String
  orderId        String?
  createdAt      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ───────────────────────────── Numbering ─────────────────────────────

/// Sequential, human-readable document numbers (INV-2026-000123 ...), one row per series.
model Counter {
  key   String @id
  value Int    @default(0)
}

// ───────────────────────────── Counter sales ─────────────────────────────

/// A bill for an in-shop (offline) sale; stock is reduced the same way as online orders.
model CounterSale {
  id            String           @id @default(cuid())
  number        String           @unique
  vendorId      String
  branchId      String
  customerName  String?
  customerPhone String?
  total         Int
  method        CollectionMethod @default(CASH)
  createdById   String?
  createdAt     DateTime         @default(now())

  vendor Vendor            @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  items  CounterSaleItem[]

  @@index([vendorId, createdAt])
  @@index([branchId, createdAt])
}

model CounterSaleItem {
  id           String @id @default(cuid())
  saleId       String
  listingId    String
  productName  String
  variantLabel String
  price        Int
  costPrice    Int?
  quantity     Int
  lineTotal    Int

  sale CounterSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

// ───────────────────────────── Audit ─────────────────────────────

/// Who did what, for the super admin. Written by services, never edited.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorRole Role?
  vendorId  String?
  action    String
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([vendorId, createdAt])
  @@index([actorId, createdAt])
}
